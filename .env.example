# Copy this file to .env and fill in your credentials.
# Never commit .env to version control.
#
# See README.md "OAuth2 setup" for how to generate these values at
# my.tastytrade.com — you never put your account password here.

TASTYTRADE_CLIENT_SECRET=your_oauth_client_secret_here
TASTYTRADE_REFRESH_TOKEN=your_personal_grant_refresh_token_here

# Set to "true" to use the TastyTrade certification (sandbox) environment.
# Default is "false" (production).
TASTYTRADE_SANDBOX=false
